# ==============================================================================
# StyleHub Backend Environment Configuration (Experiment 10 Deployment)
# ==============================================================================

# 1. Server Port (Render sets this dynamically, defaults to 5001 locally)
PORT=5001

# 2. MongoDB Database URI
# For Local Development:
MONGO_URI=mongodb://127.0.0.1:27017/stylehub

# For Production (MongoDB Atlas Cloud Cluster):
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials
MONGODB_URI=mongodb+srv://samrudhi_admin:<password>@cluster0.abcde.mongodb.net/stylehub?retryWrites=true&w=majority

# 3. Frontend Client URL (For CORS Whitelisting in Production)
# Set to your deployed Vercel domain in Render dashboard
CLIENT_URL=https://stylehub-fashion.vercel.app

# 4. Environment Mode
NODE_ENV=production
